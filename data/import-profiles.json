  "plots": [
    {
      "id": "v_t",
      "title": "Voltage against time",
      "x": "time",
      "y": "voltage",
      "needs": [
        "time",
        "voltage"
      ],
      "note": "The rawest view of a galvanostatic run. Look at it before anything derived — a step that ended on its time limit rather than its voltage limit is obvious here and invisible in a capacity number."
    },
    {
      "id": "v_q",
      "title": "Voltage against capacity",
      "x": "capacity",
      "y": "voltage",
      "needs": [
        "capacity",
        "voltage"
      ],
      "note": "The shape most battery results are read from."
    },
    {
      "id": "i_e",
      "title": "Current against potential",
      "x": "voltage",
      "y": "current",
      "needs": [
        "voltage",
        "current"
      ],
      "note": "On a potential-sweep run this IS the cyclic voltammogram, with anodic current plotted positive (IUPAC convention); if your instrument exported the opposite sign convention the curve appears mirrored, which is a convention difference and not a measurement. On a galvanostatic run it is not a voltammogram at all — the current was held constant, so the plot shows the levels it was held at.",
      "constantCurrentCheck": true
    },
    {
      "id": "nyquist",
      "title": "Nyquist plot",
      "x": "zreal",
      "y": "zimag",
      "needs": [
        "zreal",
        "zimag"
      ],
      "equalAspect": true,
      "negateY": true,
      "note": "Axes are equally scaled. A semicircle is only a semicircle, and a Warburg line only 45°, when they are — on unequal axes any line can be made to look like any angle."
    },
    {
      "id": "bode_mag",
      "title": "Bode — magnitude",
      "x": "frequency",
      "y": "zmag",
      "needs": [
        "frequency",
        "zmag"
      ],
      "logX": true,
      "note": "Logarithmic frequency axis."
    },
    {
      "id": "bode_ph",
      "title": "Bode — phase",
      "x": "frequency",
      "y": "phase",
      "needs": [
        "frequency",
        "phase"
      ],
      "logX": true,
      "note": "−90° is ideal capacitive behaviour; 0° is purely resistive."
    },
    {
      "id": "i_t",
      "title": "Current against time",
      "x": "time",
      "y": "current",
      "needs": [
        "time",
        "current"
      ],
      "note": "Worth checking on any constant-current run: a recorded current that diverges from the setpoint means the channel hit a compliance limit, and every capacity must then be integrated from the recorded current rather than the programmed one."
    },
    {
      "id": "q_cycle",
      "title": "Capacity against cycle",
      "x": "cycle",
      "y": "capacity",
      "needs": [
        "cycle",
        "capacity"
      ],
      "note": "Retention over a run. Read it alongside coulombic efficiency — efficiency usually moves first."
    },
    {
      "id": "t_t",
      "title": "Temperature against time",
      "x": "time",
      "y": "temperature",
      "needs": [
        "time",
        "temperature"
      ],
      "note": "Both a safety limit and an experimental variable. Capacity and impedance both move with it."
    }
  ]
}
